# cp stage.tfvars.example stage.tfvars  y ajustar. Los .tfvars estan en .gitignore.

project_id  = "fierro-XXXXXX"
environment = "stage"

# Se obtiene tras el primer push a Artifact Registry. En stage una etiqueta
# movil es aceptable; en production no.
api_image = "northamerica-south1-docker.pkg.dev/fierro-XXXXXX/fierro/fierro-api:stage"

cors_origins     = "https://stage.fierro.mx"
google_client_id = "XXXXXX.apps.googleusercontent.com"

# Cadenas de Neon. NO se commitean: este archivo es .example, el real esta
# en .gitignore. La primera lleva "-pooler" en el host, la segunda no.
db_dsn        = "postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/fierro?sslmode=require"
db_dsn_direct = "postgresql://USUARIO:CLAVE@ep-XXXX.REGION.aws.neon.tech/fierro?sslmode=require"

# Escala a cero: stage pasa la mayor parte del tiempo sin nadie usandolo.
min_instances = 0
max_instances = 2
