# Unidad systemd del agente de la estacion (RPi). Instalacion: deploy/rpi/README.md
[Unit]
Description=Fierro estacion de pesaje (captura + outbox + sync)
# Sin network-online.target a proposito: capturar no espera a la red (4G puede
# tardar minutos tras un corte de luz); el sync reintenta solo.
# Sin /data montado no arrancar: la outbox caeria en la raiz o en un overlay volatil.
RequiresMountsFor=/data/fierro
# Nunca dejar de reintentar: el corral no espera a que alguien entre por SSH.
StartLimitIntervalSec=0

[Service]
Type=notify
User=fierro
Group=fierro
SupplementaryGroups=dialout
EnvironmentFile=/etc/fierro/device.env
# La outbox vive en la particion de datos, no en la raiz (ver edge-reliability.md).
Environment=FIERRO_DB_PATH=/data/fierro/device.db
ExecStart=/opt/fierro/venv/bin/fierro-device run
Restart=always
RestartSec=5
# El agente manda WATCHDOG=1 al terminar cada vuelta del bucle; si una lectura se
# cuelga, systemd lo reinicia. 90 s cubren una vuelta lenta pero viva con red mala
# (sync + heartbeat, cada uno con sus timeouts HTTP y DNS).
WatchdogSec=90
NotifyAccess=main
MemoryMax=256M
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/fierro

[Install]
WantedBy=multi-user.target
