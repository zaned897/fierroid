# Nombres estables para los adaptadores USB-serie de la estacion.
# /dev/ttyUSB0 y /dev/ttyUSB1 pueden intercambiarse al reiniciar; estos enlaces no.
#
# Sacar el numero de serie de cada adaptador (conectar uno a la vez):
#   udevadm info -a -n /dev/ttyUSB0 | grep -m1 '{serial}'
# y, si hace falta, idVendor / idProduct:
#   udevadm info -a -n /dev/ttyUSB0 | grep -m1 -E '{idVendor}|{idProduct}'
#
# Reemplazar CAMBIAR-SERIE-* y copiar a /etc/udev/rules.d/ (ver README.md).
# Si dos adaptadores no traen numero de serie, usar KERNELS== con el puerto USB fisico.

SUBSYSTEM=="tty", ATTRS{serial}=="CAMBIAR-SERIE-BASCULA", SYMLINK+="fierro-bascula", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{serial}=="CAMBIAR-SERIE-LECTOR", SYMLINK+="fierro-lector", GROUP="dialout", MODE="0660"
