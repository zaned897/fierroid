# Copia a .env y ajusta. .env esta en .gitignore: nunca se commitea.
#
#   cp .env.example .env

# --- API nube ---------------------------------------------------------------
# Con FIERRO_API_DSN definido la API usa Postgres. Vacio => SQLite en DB_PATH.
# El DSN de abajo es el que expone docker compose.
FIERRO_API_DSN=postgresql://fierro:fierro@localhost:5432/fierro
FIERRO_API_DB_PATH=/tmp/fierro-api.db
FIERRO_API_HOST=0.0.0.0
FIERRO_API_PORT=8000

# --- Device agent -----------------------------------------------------------
# FIERRO_MOCK_HW=1 es obligatorio fuera de la RPi: sin el, SerialHardware
# revienta a proposito en vez de inventar un peso.
FIERRO_MOCK_HW=1
FIERRO_DEVICE_ID=rpi-dev-001
FIERRO_DB_PATH=/tmp/fierro-device.db
FIERRO_API_URL=http://127.0.0.1:8000
FIERRO_POLL_INTERVAL_S=0.5
FIERRO_SYNC_INTERVAL_S=2.0
FIERRO_MOCK_INTERVAL_S=3.0
FIERRO_SCALE_PORT=/dev/ttyUSB0
FIERRO_RFID_PORT=/dev/ttyUSB1

# --- docker compose ---------------------------------------------------------
# Cambialos si los puertos ya estan ocupados en tu maquina.
FIERRO_DB_PORT=5432

# --- Tests ------------------------------------------------------------------
# Separado del DSN de runtime: define esto para que las pruebas del store
# Postgres corran en vez de saltarse.
# FIERRO_TEST_PG_DSN=postgresql://fierro:fierro@localhost:5432/fierro
