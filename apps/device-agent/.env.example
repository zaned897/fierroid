# Prototipo Windows -> stage. Copiar a .env en este mismo directorio.
# Cargar explicitamente con el comando documentado en README.md.
FIERRO_HW_BACKEND=prototipo
FIERRO_MOCK_HW=0
FIERRO_RFID_PORT=COM6
# Estacion de pruebas ya registrada en stage; ajustar para otro banco.
FIERRO_DEVICE_ID=rpi-los-encinos-001
FIERRO_API_URL=https://fierro-api-stage-yj7cs5a7aq-pv.a.run.app
# python-dotenv expande ${LOCALAPPDATA}; no usar $env:LOCALAPPDATA aqui.
# Se conserva la misma SQLite utilizada anteriormente.
FIERRO_DB_PATH=${LOCALAPPDATA}/fierro-prototipo-com6.db
# Valor por defecto explicito para neutralizar modos heredados de la terminal.
# Las lineas W ya incluyen ADC: su peso tiene prioridad y no usa este fallback.
FIERRO_PESO_MODO=aleatorio
