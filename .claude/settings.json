{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/tools/agentes/delegar.py\" hook-stop",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "enabledPlugins": {
    "modern-web-guidance@googlechrome": true
  }
}
